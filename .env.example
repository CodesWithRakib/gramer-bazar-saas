# ==========================================
# GRAMER BAZAR MONOREPO - ENVIRONMENT TEMPLATE
# Safe placeholder template. Never put real credentials here.
# ==========================================

# ====================
# BACKEND (apps/api)
# ====================
NODE_ENV=development
PORT=4000

# Canonical URLs (Backend server and Frontend origin)
BACKEND_URL=http://localhost:4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://127.0.0.1:5000,http://127.0.0.1:5001,http://127.0.0.1:5002

# Database (PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/gramer_bazar
# Production: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin impersonation (temporary session duration in minutes; clamped 5-120)
IMPERSONATION_TTL_MINUTES=60

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
PRODUCT_IMAGE_BASE_URL=http://localhost:4000/uploads

# Supabase Storage (Optional for local dev, recommended for production media)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=gramer-bazar

# Transactional Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gramer Bazar

# Cache & Rate Limiting (Redis / Upstash)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SSLCOMMERZ Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_PAYMENT_URL=https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_PUBLIC_URL=

# Broadcast & Marketing Communication (Super Admin only)
# 'mock' simulates sends in development. 'whatsapp' is NOT implemented yet.
BROADCAST_PROVIDER=mock
# BROADCAST_MOCK_FAILURE_RATE=0
# BROADCAST_SIMULATED_RECEIPT_DELAY_MS=15000
# BROADCAST_MOCK_READ_RATE=0.7

# Future WhatsApp Business / Cloud API (NOT USED YET — see docs/broadcast/WHATSAPP_INTEGRATION.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=

# ====================
# FRONTEND (apps/web)
# ====================
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
