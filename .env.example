# ==========================================
# GRAMER BAZAR MONOREPO - ENVIRONMENT TEMPLATE
# Safe placeholder template. Never put real credentials here.
# ==========================================

# Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database (Local PostgreSQL or Remote Neon/Supabase PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/gramer_bazar
# Production Neon: postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/gramer_bazar?sslmode=require
DATABASE_URL=YOUR_DATABASE_URL

# Redis Cache (Optional in dev, required in production)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Email Notifications (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev

# Storage Configuration
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
PRODUCT_IMAGE_BASE_URL=http://localhost:4000/uploads
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_BUCKET=gramer-bazar

# Payment Gateway (SSLCommerz)
SSLCOMMERZ_STORE_ID=YOUR_SSLCOMMERZ_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=YOUR_SSLCOMMERZ_STORE_PASSWORD
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_PAYMENT_URL=https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_PUBLIC_URL=https://your-tunnel-url.ngrok-free.app

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Database Seeder Configuration (Optional overrides for deterministic testing)
SEED_ADMIN_PASSWORD=
SEED_SHOP_OWNER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_DELIVERY_PASSWORD=
