# ==============================================================================
# GRAMER BAZAR FRONTEND (apps/web) — VERCEL PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Tracked in Git as a production reference.
# Configure these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Application Canonical URLs (Vercel Production Domain)
NEXT_PUBLIC_APP_URL=https://gramer-bazar-saas.vercel.app
NEXT_PUBLIC_SITE_URL=https://gramer-bazar-saas.vercel.app

# Backend Public API URL (Render Web Service with /api/v1 prefix)
NEXT_PUBLIC_API_URL=https://gramer-bazar-api.onrender.com/api/v1

# Realtime WebSocket / Socket.IO Server URL (Render Web Service root domain)
NEXT_PUBLIC_SOCKET_URL=https://gramer-bazar-api.onrender.com

# Analytics & Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
