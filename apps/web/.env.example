# Public API URL for backend calls
# Local development: http://localhost:4000/api/v1
# Production (Render/custom domain): https://api.gramerbazar.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical Application URLs (Used for SEO, Metadata, Sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
