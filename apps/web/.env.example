# ==========================================
# GRAMER BAZAR FRONTEND (apps/web) - ENVIRONMENT TEMPLATE
# Safe placeholder template. Never put real credentials here.
# Tracked in Git as an architecture and deployment reference.
# ==========================================

# Public API URL for backend calls (including API prefix)
# Local development: http://localhost:4000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Realtime WebSocket / Socket.IO Server URL (root backend URL without /api/v1)
# Local development: http://localhost:4000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Canonical Application URLs (Used for SEO, Metadata, Sitemap, Canonical tags)
# Local development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error Tracking (Sentry Next.js - Optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Product Analytics (PostHog - Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
