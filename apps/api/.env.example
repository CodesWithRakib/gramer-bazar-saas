# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gramer_bazar"

# Authentication
JWT_ACCESS_SECRET="supersecret_access"
JWT_REFRESH_SECRET="supersecret_refresh"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend & CORS
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Rate limiting (optional). Defaults are production-safe.
# Raise these for local E2E/load testing so repeated logins from one IP are not throttled.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# AUTH_SEND_OTP_THROTTLE_LIMIT=3
# AUTH_VERIFY_OTP_THROTTLE_LIMIT=5
# AUTH_REGISTER_THROTTLE_LIMIT=5
# AUTH_LOGIN_THROTTLE_LIMIT=5
