# ==========================================
# GRAMER BAZAR BACKEND (apps/api) - ENVIRONMENT TEMPLATE
# Safe placeholder template. Never put real credentials here.
# Tracked in Git as an architecture and deployment reference.
# ==========================================

# Application Environment & Server Port
NODE_ENV=development
PORT=4000

# Canonical URLs (root URLs without /api/v1 prefix)
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:4000
API_URL=http://localhost:4000

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://127.0.0.1:5000,http://127.0.0.1:5001,http://127.0.0.1:5002

# Database Connection (PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/gramer_bazar
# Neon/Cloud: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Authentication Secrets & Expirations
# JWT_SECRET serves as canonical secret, or separate ACCESS/REFRESH secrets can be used
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin impersonation (temporary session duration in minutes; clamped 5-120)
IMPERSONATION_TTL_MINUTES=60

# File Storage & Upload Configuration
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
PRODUCT_IMAGE_BASE_URL=http://localhost:4000/uploads

# Supabase Cloud Storage (Optional in dev, recommended for production media)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=gramer-bazar

# Transactional Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gramer Bazar

# Cache & Rate Limiting (Redis / Upstash - Optional in dev, recommended for production)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# SSLCOMMERZ Payment Gateway Configuration
# ==========================================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# Sandbox initiation URL: https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
# Live initiation URL: https://securepay.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_PAYMENT_URL=https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
# Sandbox validation URL: https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
# Live validation URL: https://securepay.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
# Public HTTPS URL reachable by SSLCOMMERZ callbacks & IPN (ngrok for dev, public backend URL for prod)
SSLCOMMERZ_PUBLIC_URL=

# Rate Limiting & Throttler Overrides (Optional)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# AUTH_SEND_OTP_THROTTLE_LIMIT=3
# AUTH_VERIFY_OTP_THROTTLE_LIMIT=5
# AUTH_REGISTER_THROTTLE_LIMIT=5
# AUTH_LOGIN_THROTTLE_LIMIT=5

# Database Seeder Password Overrides (Optional - defaults to standard secure seed passwords)
# SEED_ADMIN_PASSWORD=
# SEED_SHOP_OWNER_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# SEED_DELIVERY_PASSWORD=

# ==========================================
# Broadcast & Marketing Communication
# ==========================================
# Active delivery provider: 'mock' (development, simulates sends) or 'whatsapp' (NOT implemented yet)
BROADCAST_PROVIDER=mock
# Optional: simulated transient failure rate for the mock provider (0 - 1)
# BROADCAST_MOCK_FAILURE_RATE=0
# Optional: delay before simulated delivered/read receipts (ms)
# BROADCAST_SIMULATED_RECEIPT_DELAY_MS=15000
# Optional: probability a simulated delivered message is marked read (0 - 1)
# BROADCAST_MOCK_READ_RATE=0.7
# Set to 'true' to disable the in-process broadcast worker (e.g. during migrations)
# DISABLE_BROADCAST_WORKER=false

# ==========================================
# FUTURE WhatsApp Business / Cloud API (NOT USED YET)
# See docs/broadcast/WHATSAPP_INTEGRATION.md before enabling.
# Do NOT commit real credentials.
# ==========================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=
