# ==========================================
# GRAMER BAZAR API - ENVIRONMENT TEMPLATE
# Safe placeholder template. Never put real credentials here.
# ==========================================

# Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database
# Local: postgresql://postgres:password@localhost:5432/gramer_bazar
# Production Neon: postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/gramer_bazar?sslmode=require
DATABASE_URL=YOUR_DATABASE_URL

# Redis Cache (Optional for dev, required for production)
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Rate limiting (optional). Defaults are production-safe.
# Raise these for local E2E/load testing so repeated logins from one IP are not throttled.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# AUTH_SEND_OTP_THROTTLE_LIMIT=3
# AUTH_VERIFY_OTP_THROTTLE_LIMIT=5
# AUTH_REGISTER_THROTTLE_LIMIT=5
# AUTH_LOGIN_THROTTLE_LIMIT=5

# Email Notifications (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev

# ==========================================
# SSLCOMMERZ CONFIGURATION
# ==========================================
SSLCOMMERZ_STORE_ID=YOUR_SSLCOMMERZ_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=YOUR_SSLCOMMERZ_STORE_PASSWORD
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_PAYMENT_URL=https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_PUBLIC_URL=https://your-tunnel-url.ngrok-free.app

# Storage & Local Images
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
PRODUCT_IMAGE_BASE_URL=http://localhost:4000/uploads
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_BUCKET=gramer-bazar

# Database Seeder Configuration (Optional overrides for deterministic testing)
SEED_ADMIN_PASSWORD=
SEED_SHOP_OWNER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_DELIVERY_PASSWORD=

