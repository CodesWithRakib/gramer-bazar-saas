# ==============================================================================
# GRAMER BAZAR BACKEND (apps/api) — RENDER DEPLOYMENT TEMPLATE
# ==============================================================================
# Safe template for Render Web Service environment variable configuration.
# Fill in these variables in the Render Dashboard (Environment tab).
# ==============================================================================

NODE_ENV=production
PORT=10000

# Canonical URLs (Keep root server URL separate from API prefix)
# Frontend deployment origin on Vercel
FRONTEND_URL=https://gramer-bazar-saas.vercel.app
CORS_ORIGINS=https://gramer-bazar-saas.vercel.app

# Backend Public URL (Your Render Web Service URL)
BACKEND_URL=https://<your-render-service>.onrender.com
API_URL=https://<your-render-service>.onrender.com

# Database Connection (Neon PostgreSQL Pooler)
# e.g.: postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL=

# Authentication Secrets (Strong random 64-character secrets)
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Supabase Cloud Storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=gramer-bazar
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880

# Transactional Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gramer Bazar

# Distributed Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or standard Redis URL:
# REDIS_URL=rediss://default:<token>@<host>:6379

# Payment Gateway (SSLCOMMERZ)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_PAYMENT_URL=https://sandbox-gw.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_PUBLIC_URL=https://<your-render-service>.onrender.com
