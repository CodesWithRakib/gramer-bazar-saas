{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/seeder/seed-cli.js",
    "verify:seed": "node dist/seeder/verify-seed.js",
    "typeorm": "node ./node_modules/typeorm/cli.js -d dist/config/data-source.js",
    "migration:show": "node ./node_modules/typeorm/cli.js migration:show -d dist/config/data-source.js",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/data-source.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/config/data-source.js",
    "migration:generate": "node ./node_modules/typeorm/cli.js migration:generate -d dist/config/data-source.js"
  },
  "dependencies": {
    "@gramer-bazar/types": "workspace:*",
    "@nestjs/cache-manager": "^12.0.0",
