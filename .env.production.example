# ==============================================================================
# GRAMER BAZAR — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# This file is a documentation and hosting setup guide.
# Do NOT put real secrets in this file.
# Supply the real values securely through your hosting platform dashboard
# (e.g. Render / Railway / Vercel / Docker secrets / Kubernetes secrets).
# ==============================================================================

# ==========================================
# BACKEND (apps/api - e.g. Render / Railway)
# ==========================================
NODE_ENV=production
PORT=4000

# Canonical URLs (Keep root URL separate from API prefix)
# Set FRONTEND_URL to your production frontend domain (for CORS & redirects)
FRONTEND_URL=https://www.gramerbazar.com
# Set BACKEND_URL to your production API server root
BACKEND_URL=https://api.gramerbazar.com
API_URL=https://api.gramerbazar.com

# CORS Allowed Origins
CORS_ORIGINS=https://www.gramerbazar.com,https://gramerbazar.com

# Database Connection (Neon PostgreSQL / AWS RDS / Supabase Postgres)
# e.g.: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Authentication Secrets (Strong random 64-char strings)
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Supabase Storage is recommended for production)
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SECRET_KEY=<your-supabase-secret-key>
SUPABASE_BUCKET=gramer-bazar

# Transactional Email (Resend)
RESEND_API_KEY=re_<your_resend_api_key>
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gramer Bazar

# Cache & Rate Limiting (Upstash Redis or standard Redis)
# Standard Redis: redis://:<password>@<host>:<port>
REDIS_URL=
# Or Upstash REST credentials:
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# ==========================================
# SSLCOMMERZ Payment Gateway (Live Mode)
# ==========================================
SSLCOMMERZ_STORE_ID=<your-live-store-id>
SSLCOMMERZ_STORE_PASSWORD=<your-live-store-password>
SSLCOMMERZ_IS_LIVE=true
SSLCOMMERZ_PAYMENT_URL=https://securepay.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://securepay.sslcommerz.com/validator/api/validationserverAPI.php
# Public backend root domain for SSLCOMMERZ callbacks and IPN
SSLCOMMERZ_PUBLIC_URL=https://api.gramerbazar.com

# ==========================================
# FRONTEND (apps/web - e.g. Vercel)
# ==========================================
# Public API URL (including /api/v1 prefix)
NEXT_PUBLIC_API_URL=https://api.gramerbazar.com/api/v1

# Realtime WebSocket server URL (root domain without /api/v1)
NEXT_PUBLIC_SOCKET_URL=https://api.gramerbazar.com

# Canonical frontend site URL (for OpenGraph, sitemap, robots, and metadata)
NEXT_PUBLIC_APP_URL=https://www.gramerbazar.com
NEXT_PUBLIC_SITE_URL=https://www.gramerbazar.com

# Error Monitoring (Sentry Next.js - Optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Product Analytics (PostHog - Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
