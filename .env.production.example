# GRAMER BAZAR PRODUCTION ENVIRONMENTS

# ====================
# BACKEND (apps/api)
# ====================
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres:password@postgres:5432/gramer_bazar
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

# URLs
FRONTEND_URL=https://www.gramerbazar.com

# 3rd Party
RESEND_API_KEY=re_your_resend_key
SENTRY_DSN=your_sentry_node_dsn

# ====================
# FRONTEND (apps/web)
# ====================
NEXT_PUBLIC_API_URL=https://api.gramerbazar.com/api/v1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_nextjs_dsn
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
